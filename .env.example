# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY is used only for server-side administrative actions if needed (NEVER exposed to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Application Mode
# Set to 'true' to allow quick-access demo credentials when Supabase is not yet connected
NEXT_PUBLIC_ALLOW_DEMO_MODE=true
